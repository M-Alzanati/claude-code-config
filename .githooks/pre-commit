#!/bin/sh
# Repo-local pre-commit. Chains the global hook (ECC secret scanner) and then
# validates this config, so a broken settings.json can never be committed.
# Skip once with: git commit --no-verify
g=$(git config --global core.hooksPath 2>/dev/null)
if [ -n "$g" ] && [ -x "$g/pre-commit" ]; then
    "$g/pre-commit" || exit 1
fi
# Validate the checkout being committed, not whatever is deployed in ~/.claude.
root=$(git rev-parse --show-toplevel)
exec env CLAUDE_CONFIG_DIR="$root" "$root/check.sh"
